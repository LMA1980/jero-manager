[Unit]
Description=Jero Manager Control Plane and Inference Orchestrator
Documentation=https://github.com/LMA1980/jero-manager
Requires=jero-kv-cache.service
After=network-online.target jero-kv-cache.service
Wants=network-online.target

[Service]
Type=simple
Slice=jero-runner.slice
Delegate=yes
User=jero-runner
Group=jero-runner
WorkingDirectory=/var/lib/jero-runner
RuntimeDirectory=jero-runner
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
EnvironmentFile=-/etc/jero-runner/endpoints.env
Environment=JERO_STORE_ROOT=/var/lib/jero-runner
Environment=JERO_KV_SOCKET=/run/jero-runner/kv.sock
ExecStart=/usr/local/bin/jero-manager
Restart=always
RestartSec=5
LimitMEMLOCK=29360128K

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/jero-runner /run/jero-runner
InaccessiblePaths=/etc/shadow /root

[Install]
WantedBy=multi-user.target
